# Bu faylni serverda `.env.prod` nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.prod.example .env.prod

# --- Domain ---
# Oracle VM'ning public IP manzilini nip.io formatiga o'tkazing:
# masalan IP 130.61.12.34 bo'lsa -> DOMAIN=130-61-12-34.nip.io
DOMAIN=your-server-ip-with-dashes.nip.io

# --- PostgreSQL ---
POSTGRES_USER=bilimsari
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bilimsari

# --- Backend (FastAPI) ---
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://your-server-ip-with-dashes.nip.io
DEFAULT_TEST_PASS_THRESHOLD=60
ENV=production

# --- Telegram ---
BOT_TOKEN=your_real_bot_token_here
WEBAPP_URL=https://your-server-ip-with-dashes.nip.io

# --- Frontend (build-time) ---
VITE_API_BASE_URL=https://your-server-ip-with-dashes.nip.io/api
